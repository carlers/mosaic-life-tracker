# DR administrator commands. These values are server-side only; never use VITE_.
# APPWRITE_TARGET_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# APPWRITE_TARGET_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# DR_ENCRYPTION_KEY_B64=
# DR_KEY_VERSION=v1
# DR_ENCRYPTION_KEYS_JSON={"v1":"<base64-32-byte-key>"}
# DR_PREFIX=mosaic-dr/v1
# DR_STALE_HOURS=36
