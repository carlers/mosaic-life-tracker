# Fresh forks should generate .env.local with:
#   npm run mosaic:bootstrap -- --project <APPWRITE_PROJECT_ID> --endpoint <APPWRITE_ENDPOINT>
# Do not point a fork at somebody else's project.
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<project-id>
# Canonical browser origin used in Appwrite recovery callback URLs (no path).
VITE_PUBLIC_APP_ORIGIN=https://mosaic.example.com
VITE_APPWRITE_DATABASE_ID=life_tracker
VITE_APPWRITE_STORAGE_BUCKET_ID=task_images
VITE_APPWRITE_MESSAGE_ACTION_FUNCTION_ID=message_action

VITE_APPWRITE_TABLE_TASKS=tasks
VITE_APPWRITE_TABLE_CATEGORIES=categories
VITE_APPWRITE_TABLE_DIARY=diary
VITE_APPWRITE_TABLE_SETTINGS=settings
VITE_APPWRITE_TABLE_FRIENDSHIPS=friendships
VITE_APPWRITE_TABLE_PROFILES=profiles
VITE_APPWRITE_TABLE_MESSAGES=messages

# Temporary bootstrap administration. Never prefix the API key with VITE_.
# APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=<project-id>
# APPWRITE_API_KEY=<temporary-provisioning-key>

# Optional DR administrator commands. These values are server-side only; never use VITE_.
# APPWRITE_TARGET_ENDPOINT=https://<region>.cloud.appwrite.io/v1
# APPWRITE_TARGET_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# DR_ENCRYPTION_KEY_B64=
# DR_KEY_VERSION=v1
# DR_ENCRYPTION_KEYS_JSON={"v1":"<base64-32-byte-key>"}
# DR_PREFIX=mosaic-dr/v1
# DR_MAX_AGE_HOURS=36
