{
  "$id": "6aa8057f002a4c306fdd",
  "name": "message-action",
  "enabled": true,
  "logging": true,
  "runtime": "node-18.0",
  "execute": [
    "users"
  ],
  "scopes": [
    "users.read",
    "users.write",
    "sessions.write",
    "rows.read",
    "rows.write",
    "tables.read",
    "files.read",
    "files.write",
    "execution.write"
  ],
  "schedule": "0 * * * *",
  "timeout": 120,
  "entrypoint": "main.js",
  "commands": "npm install",
  "deploymentRetention": 0,
  "nonSecretVariables": {
    "TOMBSTONE_RETENTION_DAYS": "90",
    "APPWRITE_DATABASE_ID": "life_tracker",
    "APPWRITE_STORAGE_BUCKET_ID": "task_images",
    "APPWRITE_TABLE_ACCOUNT_DELETIONS": "account_deletions",
    "DR_BACKUP_FUNCTION_ID": "dr_backup",
    "DR_PRIVACY_DELETION_REQUIRED": "true"
  },
  "requiredSecretVariables": [],
  "events": [
    "tablesdb.life_tracker.tables.tasks.rows.*.create",
    "tablesdb.life_tracker.tables.tasks.rows.*.update"
  ],
  "optionalNonSecretVariables": [
    "NOTIFICATIONS_LAUNCH_AT",
    "WEB_PUSH_VAPID_PUBLIC_KEY",
    "WEB_PUSH_VAPID_SUBJECT"
  ],
  "optionalSecretVariables": [
    "WEB_PUSH_VAPID_PRIVATE_KEY"
  ]
}
