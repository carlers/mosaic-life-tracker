  const visible = reactions.slice(0, MAX_VISIBLE);
  const overflow = reactions.length - visible.length;
  return (
    <div
      className={`flex items-center flex-wrap gap-1 mt-1 max-w-[78%] ${
        isOutgoing ? 'justify-end' : 'justify-start'
      }`}
