            backgroundColor: task.completed ? categoryColor : 'transparent',
            borderColor: task.completed ? categoryColor : '#333333',
          }}
        >
          {task.completed && (
            <Check size={12} className="text-white" strokeWidth={3} />
          )}
        </button>
