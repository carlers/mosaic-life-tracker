          >
            <span className="text-[12px]">{r.emoji}</span>
            <span className="font-medium">{r.userIds.length}</span>
          </motion.button>
        );
      })}
      {overflow > 0 && (
        <span className="text-[10px] text-gray-500 px-1">+{overflow}</span>
      )}
    </div>
  );
};
