            label="Account"
            value={user?.email}
            onClick={() => setIsAccountSettingsOpen(true)}
          />
          <SettingsRow icon={<Lock size={18} className="text-gray-400" />} label="Privacy" onClick={handleComingSoon} />
          <SettingsRow icon={<Shield size={18} className="text-gray-400" />} label="App Permissions" onClick={handleComingSoon} />
          <SettingsRow icon={<Monitor size={18} className="text-gray-400" />} label="Screen" onClick={handleComingSoon} />
          <SettingsRow icon={<Bell size={18} className="text-gray-400" />} label="Notifications" onClick={handleComingSoon} />
          <SettingsRow
