export const SettingsPage: React.FC = () => {
  const { user, logout } = useAuth();
  const navigate = useNavigate();
  const [isClearDataOpen, setIsClearDataOpen] = useState(false);
  const [isClearingData, setIsClearingData] = useState(false);
