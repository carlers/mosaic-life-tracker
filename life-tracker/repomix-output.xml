    taskRows = await listAllRows(
      tablesDB,
      TASKS_TABLE,
      [
        Query.equal('user_id', friendUserId),
        Query.equal('deleted', false),
      ],
      log
    );
  } catch (err) {
    error(`get_friend_calendar: tasks fetch failed (${err.message})`);
    return { status: 500, body: { error: 'Failed to fetch tasks' } };
  }
