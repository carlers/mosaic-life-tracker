          />
          <SettingsRow icon={<Smile size={18} className="text-gray-400" />} label="My stickers" onClick={handleComingSoon} />
          <SettingsRow icon={<Info size={18} className="text-gray-400" />} label="Information" onClick={handleComingSoon} />
          <SettingsRow icon={<HelpCircle size={18} className="text-gray-400" />} label="FAQs" onClick={handleComingSoon} />
        </div>
        {}
        <div className="border-t border-[#333333] py-2">
          <SettingsRow
