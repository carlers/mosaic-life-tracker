  const res = await guardedTablesDB.listRows({
    databaseId: APPWRITE_CONFIG.databaseId,
    tableId: APPWRITE_CONFIG.tables.profiles,
    queries: [
      Query.startsWith('username', trimmed),
      Query.equal('deleted', false),
      Query.limit(limit),
