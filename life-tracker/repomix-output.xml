                  </div>
                </div>
              )}
              {reactions.length > 0 && (
                <div className="mt-1.5">
                  <ReactionRow
                    reactions={reactions}
                    currentUserId={currentUserId}
                    isOutgoing={false}
                    onToggle={() => {
                    }}
                  />
                </div>
              )}
            </div>
          )}
        </div>
        {!isEditing && (
          <div className="flex items-center gap-2 flex-shrink-0 pointer-events-none">
