      console.log('ℹ️  Column is_unsent already exists, skipping');
    } else {
      throw err;
    }
  }
}
async function main() {
  try {
    await addUnsentColumn();
    console.log('🎉 Done');
  } catch (err) {
    console.error('❌ Migration failed:', err.message ?? err);
    process.exit(1);
  }
}
main();
