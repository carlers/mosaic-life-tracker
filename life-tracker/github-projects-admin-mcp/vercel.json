{
  "version": 2,
  "framework": null,
  "rewrites": [
    {"source": "/.well-known/oauth-protected-resource", "destination": "/api/metadata?kind=resource"},
    {"source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/metadata?kind=resource"},
    {"source": "/.well-known/oauth-authorization-server", "destination": "/api/metadata?kind=authorization"},
    {"source": "/api/oauth/register", "destination": "/api/oauth?route=register"},
    {"source": "/api/oauth/authorize", "destination": "/api/oauth?route=authorize"},
    {"source": "/api/oauth/github-callback", "destination": "/api/oauth?route=github-callback"},
    {"source": "/api/oauth/token", "destination": "/api/oauth?route=token"}
  ],
  "functions": {"api/*.js": {"maxDuration": 30}}
}
